# Never commit your real .env file or Telegram token to GitHub.
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_CHAT_ID=-1001234567890

# For Render, set DATABASE_URL from the Render PostgreSQL internal connection string.
# For local development, SQLite is fine:
DATABASE_URL=sqlite:///./listing_bot.db

POLL_SECONDS=30
REQUEST_TIMEOUT=15
LOOKBACK_HOURS=72
DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO

# Optional: override an official announcement page URL after verifying it.
# Set to "disabled" to disable a source.
# SOURCE_BINANCE_URL=https://...
# SOURCE_OKX_URL=https://...
# SOURCE_MEXC_URL=https://...
# SOURCE_BITGET_URL=https://...
# SOURCE_GATEIO_URL=https://...
# SOURCE_UPBIT_URL=https://...
# SOURCE_KUCOIN_URL=https://...
# SOURCE_BYBIT_URL=https://...
# SOURCE_HTX_URL=https://...
# SOURCE_BINGX_URL=https://...
# SOURCE_LBANK_URL=https://...

ANNOUNCEMENT_KEYWORDS=will list,listing,lists on,spot trading,will launch trading,will add support for,available for trading,listing announcement,new listing,launchpool,pre-market
TRADING_KEYWORDS=trading will open,spot trading will open,trading starts,trading to begin,will open trading,will be available for trading
